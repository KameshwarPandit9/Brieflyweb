{
  "manifest_version": 3,
  "minimum_chrome_version": "141",
  "name": "BrieflyWeb — AI Web Assistant",
  "version": "0.3.0",
  "key": "",
  "description": "Summarize the current page, save useful notes, and review site risk.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://*/*",
    "https://*/*",
    "http://localhost:8001/*"
  ],
  "action": {
    "default_title": "Open BrieflyWeb assistant"
  },
  "side_panel": {
    "default_path": "assistant.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page-capture.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
